# =========================================================================
# Sharada Public School SMS — Environment
# =========================================================================
# DATABASE: PostgreSQL  (local DBeaver-managed database)
# =========================================================================
#
# Connection string format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# --- Default local setup (change PASSWORD / DATABASE to match yours) ---
#
#   USER     : postgres            (default superuser created at PG install)
#   PASSWORD : the password you set during `pg_ctl initdb` / installer
#   HOST     : localhost           (or 127.0.0.1)
#   PORT     : 5432                (default PostgreSQL port)
#   DATABASE : sharada_sms         (the DB you created — see README)
#   schema   : public              (Prisma default; do not change)
#
# Special characters in the password MUST be URL-encoded.
#   e.g.  pa$$word  ->  pa%24%24word
#        p@ss:word  ->  p%40ss%3Aword
#
# =========================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sharada_sms?schema=public"

# -------------------------------------------------------------------------
# Optional: JWT secret used to sign auth tokens.
# Change this to a long random string in production.
# -------------------------------------------------------------------------
JWT_SECRET="sharda-sms-dev-secret-change-in-prod-9f2c"

# -------------------------------------------------------------------------
# Optional: cookie name for the auth token (no need to change)
# -------------------------------------------------------------------------
# COOKIE_NAME=sms_token
