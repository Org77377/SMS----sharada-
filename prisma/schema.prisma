// Sharada Public School SMS — Prisma schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique // Superadmin | Principal | HOD | Exam Coordinator | Technical Admin | Teacher
  users     User[]
  notifications Notification[]
  createdAt DateTime @default(now())
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "Science & Mathematics", "Languages"
  subjects  Subject[]
  hods      User[]
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  phone        String?  // mobile number
  email        String?  // email address
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  departmentId String?  // for HODs — which department they head
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments      TeacherAssignment[]
  units            Unit[]
  sentNotifications Notification[] @relation("NotificationSender")
  receivedNotifications Notification[] @relation("NotificationRecipient")
  pendingActionsRequested PendingAction[] @relation("PendingActionRequester")
  pendingActionsReviewed  PendingAction[] @relation("PendingActionReviewer")
}

// Pending actions proposed by Technical Admin, requiring Principal approval.
// Stores the proposed change payload; executed only when the Principal approves.
model PendingAction {
  id           String   @id @default(cuid())
  requesterId  String   // Technical Admin who proposed
  actionType   String   // "USER_CREATE" | "USER_UPDATE" | "USER_DELETE"
  targetUserId String?  // for UPDATE/DELETE — the teacher being changed
  targetName   String?  // snapshot of the target user's name for display
  actionData   String   // JSON string of the proposed change payload
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewerId   String?
  reviewerNote String?
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?

  requester  User   @relation("PendingActionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer   User?  @relation("PendingActionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
}

model Grade {
  id           String   @id @default(cuid())
  gradeNumber   Int      @unique // 4..10
  displayName   String   // "Grade 4"
  assignments  TeacherAssignment[]
  units        Unit[]
  createdAt     DateTime @default(now())
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  departmentId String?  // which department this subject belongs to
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments TeacherAssignment[]
  units       Unit[]
  createdAt   DateTime @default(now())
}

model AcademicYear {
  id          String   @id @default(cuid())
  year        String   @unique // "2025-2026"
  active      Boolean  @default(false)
  assignments TeacherAssignment[]
  units       Unit[]
  createdAt   DateTime @default(now())
}

model TeacherAssignment {
  id              String   @id @default(cuid())
  teacherId       String
  gradeId         String
  subjectId       String
  academicYearId  String
  teacher         User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  grade           Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([teacherId, gradeId, subjectId, academicYearId])
}

model Unit {
  id                 String   @id @default(cuid())
  gradeId            String
  subjectId          String
  academicYearId     String
  term               String   // "Term 1" | "Term 2"
  unitName           String
  topics            String
  learningObjectives String?
  status             String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED
  feedback           String?
  createdById        String
  grade              Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject            Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear @relation(fields: [academicYearId], references: [id])
  createdBy          User     @relation(fields: [createdById], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([gradeId, subjectId, term, unitName, academicYearId])
}

model Notification {
  id            String   @id @default(cuid())
  senderId      String
  recipientId   String?  // null => broadcast to a role
  targetRoleId  String?  // role-based broadcast target
  title         String
  message       String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  sender    User     @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User?    @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  targetRole Role?   @relation(fields: [targetRoleId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  detail    String?
  createdAt DateTime @default(now())
}
